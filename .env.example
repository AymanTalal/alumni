# Local development settings ONLY — never use these values in production.
# Copy this file to .env to change them: cp .env.example .env
# (.env is ignored by git. docker compose up also works without a .env file,
# because docker-compose.yml has the same values as defaults.)

# PostgreSQL database (the "db" service in docker-compose.yml)
POSTGRES_USER=alumni
POSTGRES_PASSWORD=alumni_dev_password
POSTGRES_DB=alumni

# Connection string for the database.
# - Running the app on your machine (npm run dev): the database is at localhost:5432.
# - Inside Docker, docker-compose.yml builds its own DATABASE_URL for the app container
#   from the values above, with the host "db" (the service name) instead of localhost.
# The app doesn't use the database yet; that comes in the next step.
DATABASE_URL=postgresql://alumni:alumni_dev_password@localhost:5432/alumni
